# Claude
ANTHROPIC_API_KEY=sk-ant-...

# QuickBooks Online app (developer.intuit.com -> your app -> Keys & credentials)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# sandbox while testing, production when connected to the real STC Tours company
QBO_ENV=sandbox
# Where the OAuth tokens are stored after `npm run auth` (keep this file private)
QBO_TOKEN_FILE=.qbo-tokens.json
# Optional: bank/undeposited-funds account Id to deposit to. Leave blank for Undeposited Funds.
QBO_DEPOSIT_ACCOUNT_ID=
# Optional: year to assume when the ledger writes "9/28" with no year. Defaults to the current year.
LEDGER_YEAR=
